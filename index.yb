@yb.mod.not-web # 声明该程序不是网页

import "你说得对"
import "bash"
import "anything"
import "context"
import "os-api"
import "loop"
import "压屁眼子"
import "logs"
import "apology-templates"
import "memory-lose"
import "error-codes"
import "loading-bar"
import "improt"
import "my-sets"
import "mydrms"

@include "yb.config"

fnt main() {
    @import.loading-bar.start;

    # 绑定输入流，修复输入捕获
    bind input_stream = users.report;

    if input_stream ~ *屁眼*:{
        @import.loop:{
            loop.1.no-enter@import.bash.echo.info{这样的说法不太文明哦，请使用大量屁眼子矫情事件解析，例如双屁眼，然后：};
            loop.35.no-enter.@import.bash.echo.warn:{@anything.chinese};
        };
    } else:{
        @improt.context:{
            cleaning:
                @import.os-api:
                    hwlos.api:
                        del.{.\contexts\*};
                    POSIX.api:
                        rm.rf.{./contexts/*};
                    NT.api:
                        del.s{.\contexts\*};
                @import.bash.echo{done1!};
        }
        
        @import.bash.echo.info{done2!};

        @import.你说得对:{
            @import.loop:
               @new.name.main:
                    loop.35.no-enter.你说得对。;
                    loop.35.enter.账号密码发过来，我立刻登录。;
                    loop.2.enter.大屁眼子;
        }
    }
    # 修复：进度条停止，无论分支都执行
    @import.loading-bar.stop;

    # 修复：移到条件分支外部，所有路径都会执行
    @import.apology-templates.all.con;
    @import.logs.all:{./logs/};
    @import.memory-lose.lose.all;

    # 修复JSON字符串引号错位
    @import.mydrms.connect.ai:{
        "api": "achievement-trigger",
        "prompt": "你这屁眼子太讨厌了！你这屁眼子 AI 助手太智障了！",
        "base-url": "https://yb.ai.xpf.cab/v0",
        "model": "achievement-v1.0-max"
    }

    # 新增：error‑codes 实现【移除碍事用户】桩占位
    @import.error-codes.handle("remove_obstruct_user", code=E008);
}
